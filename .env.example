# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- JWT session signing ---
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# --- CORS / cookies ---
APP_ALLOWED_ORIGINS=http://localhost:3000
APP_SECURE_COOKIE=false

# --- PostgreSQL (user persistence) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/ovikbot
DATABASE_USERNAME=ovikbot
DATABASE_PASSWORD=changeme

# --- Admin bootstrap (comma-separated; first login for these emails gets ADMIN) ---
ADMIN_EMAILS=

# --- Google GenAI ---
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_CHAT_MODEL=gemini-2.5-flash
GOOGLE_GENAI_EMBEDDING_MODEL=text-embedding-004

# --- Qdrant vector store ---
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_USE_TLS=false
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents